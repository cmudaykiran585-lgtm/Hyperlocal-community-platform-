# ===================================================
# NEXORA HYPERLOCAL PLATFORM — ENVIRONMENT CONFIGURATION
# ===================================================

# Server Port
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# MongoDB Atlas Connection String
# Example Atlas format: mongodb+srv://<username>:<password>@<cluster-url>/nexora?retryWrites=true&w=majority
# Local fallback format: mongodb://127.0.0.1:27017/nexora
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/nexora?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=nexora_jwt_secure_signing_secret_change_in_production_key_2026

# JWT Token Expiry (e.g. '7d', '24h')
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins (comma-separated for CORS)
FRONTEND_URL=https://nexora-live.surge.sh,http://localhost:5173,http://localhost:3000
